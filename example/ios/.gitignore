# Keep the portable Xcode project, shared scheme, and referenced source/assets.
/**
!/.gitignore
!/Flutter/
!/Flutter/AppFrameworkInfo.plist
!/Flutter/Debug.xcconfig
!/Flutter/Release.xcconfig
!/Runner.xcodeproj/
